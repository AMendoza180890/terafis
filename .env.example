# =============================================================================
# Terafis — variables de entorno (desarrollo local)
# Copiar a .env.local (NUNCA subir .env.local al git).
# =============================================================================
#
# REGLA DE ORO
# - Solo NEXT_PUBLIC_* llega al navegador (anon key + URL pública).
# - Service role, DATABASE_URL, cifrado, HMAC, CRON, Twilio, Google = SOLO servidor.
# - No cree variables NEXT_PUBLIC_* con "SECRET", "SERVICE_ROLE", "PRIVATE", etc.
#
# Generar claves de 32 bytes (base64):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Generar CRON_SECRET:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# =============================================================================

# --- Público (navegador) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Supabase servidor (NUNCA en el cliente) ---
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Prisma / scripts de migración (opcional en runtime de Next)
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# --- Cifrado clínico (obligatorio en producción) ---
FIELD_ENCRYPTION_KEY=
SEARCH_HMAC_KEY=

# --- Cron / jobs (obligatorio en producción) ---
CRON_SECRET=

# --- Turnstile (opcional) ---
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# --- Recordatorios (opcional) ---
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=citas@tu-clinica.com
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# --- Google Calendar (opcional) ---
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# GOOGLE_CALENDAR_ID=
# GOOGLE_WORKSPACE_DELEGATED_USER=
# GOOGLE_CALENDAR_DRY_RUN=true
