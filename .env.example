# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (público) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Supabase (solo servidor; NUNCA en el cliente) ---
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# --- Cifrado de campos clínicos (AES-256-GCM). Generar con:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=

# --- HMAC para búsqueda por igualdad exacta (sal por tenant en producción)
SEARCH_HMAC_KEY=

# --- Turnstile / CAPTCHA (endpoints públicos)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# --- Recordatorios (Fase 3) ---
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=citas@tu-clinica.com
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# CRON_SECRET=generar-secreto-largo

# --- Google Calendar (service account JSON en una sola línea, o path en Vault) ---
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# GOOGLE_CALENDAR_ID=
# GOOGLE_WORKSPACE_DELEGATED_USER=
