# =============================================================================
# Terafis — plantilla de producción
# Configure estos valores en el panel del host (Vercel / Docker / VM).
# NO commitear este archivo relleno con secretos reales.
# =============================================================================
#
# Checklist:
# [ ] NEXT_PUBLIC_APP_URL con HTTPS del dominio real
# [ ] Anon key (pública) + Service role (secreta) de Supabase producción
# [ ] FIELD_ENCRYPTION_KEY y SEARCH_HMAC_KEY únicos de prod (no reutilizar dev)
# [ ] CRON_SECRET largo; proteger /api/cron/* con ese header
# [ ] Rotar claves si alguna se filtró en chat, git o logs
# [ ] pnpm run check:env:prod  (antes del deploy)
# =============================================================================

NODE_ENV=production
# En Vercel/producción real active validación estricta de HTTPS:
TERAFIS_STRICT_ENV=1

# --- Público ---
NEXT_PUBLIC_APP_URL=https://app.tu-dominio.com
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Secretos de servidor (obligatorios) ---
SUPABASE_SERVICE_ROLE_KEY=
FIELD_ENCRYPTION_KEY=
SEARCH_HMAC_KEY=
CRON_SECRET=

# --- Base de datos (Prisma / migraciones; no exponer al browser) ---
DATABASE_URL=

# --- Opcionales de producción ---
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=noreply@tu-dominio.com
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# GOOGLE_CALENDAR_ID=
# GOOGLE_WORKSPACE_DELEGATED_USER=
